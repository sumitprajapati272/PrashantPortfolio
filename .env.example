# The portfolio assistant uses a local frontend knowledge base and needs no AI credentials.

# --- Contact form email delivery (SMTP) ---
# The contact form only sends mail when ALL of these are set; otherwise the API answers 503
# and the site tells visitors the message was not sent. Never commit your real .env file.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<your gmail>,
# SMTP_PASS=<a Google "App Password" (needs 2-Step Verification), not your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Where contact messages are delivered
CONTACT_TO_EMAIL=
# Optional sender address (defaults to SMTP_USER)
CONTACT_FROM_EMAIL=


GMAIL_USER=sumitprajapati272@gmail.com
GMAIL_APP_PASSWORD=bfva nsvr ohxv hrjy
NOTIFY_EMAIL=sumitprajapati272@gmail.com